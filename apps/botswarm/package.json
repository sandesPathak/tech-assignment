{
  "name": "@hijack/botswarm",
  "version": "0.1.0",
  "private": true,
  "description": "Hijack Poker bot swarm — load generator, scriptable strategy profiles.",
  "main": "src/runner.js",
  "scripts": {
    "start": "node src/runner.js",
    "smoke": "node src/runner.js --bots=100 --duration=60",
    "test": "jest"
  },
  "bin": {
    "hijack-botswarm": "src/runner.js"
  },
  "dependencies": {
    "@hijack/observability": "*",
    "@hijack/protocol": "*",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@hijack/gateway": "*",
    "@hijack/worker": "*",
    "@hijack/engine": "*",
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.js"],
    "testTimeout": 30000
  }
}
