# ─── Public (browser) ──────────────────────────────────────────────
# Gateway WebSocket base URL. The web app opens
# `${NEXT_PUBLIC_GATEWAY_WS_URL}/table/:id?token=<jwt>` and
# `${NEXT_PUBLIC_GATEWAY_WS_URL}/lobby?stake=<id>`.
NEXT_PUBLIC_GATEWAY_WS_URL=ws://localhost:3002

# Gateway HTTP base URL — REST endpoints (`/lobby/:stake`,
# `/handoff/issue`, `/handoff/redeem`).
NEXT_PUBLIC_GATEWAY_HTTP_URL=http://localhost:3002

# Optional API base used for non-gateway calls (defaults to same origin).
NEXT_PUBLIC_API_BASE=

# OTel collector endpoint (e.g. Grafana Cloud OTLP). When unset, the web
# tracing module is a no-op — same fail-open semantics as the worker
# observability package.
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── Server-only ───────────────────────────────────────────────────
# Shared secret with the gateway — used to mint short-lived JWTs from
# `/api/jwt`. MUST match `GATEWAY_JWT_SECRET` set on the gateway pod.
JWT_SIGNING_SECRET=test-secret-do-not-use-in-prod

# Session secret for the demo sign-in stub (`/api/auth`). Any string.
SESSION_SECRET=dev-session-secret

# Gateway HTTP URL used by Next.js server-side (mirrors public var so the
# /api/coach proxy works in both browser and server contexts).
GATEWAY_HTTP_URL=http://localhost:3002
