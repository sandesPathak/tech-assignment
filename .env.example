# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=hijack
MYSQL_PASSWORD=hijack_dev
MYSQL_DATABASE=hijack_poker
MYSQL_ROOT_PASSWORD=rootpassword

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# DynamoDB Local
DYNAMODB_ENDPOINT=http://dynamodb-local:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ElasticMQ (SQS Local)
SQS_ENDPOINT=http://elasticmq:9324
SQS_HOLDEM_QUEUE_URL=http://elasticmq:9324/000000000000/holdem-processor-queue

# EventBridge Mock
EVENTBRIDGE_ENDPOINT=http://eventbridge-mock:4010
EVENT_BUS_NAME=poker-events

# Service Ports (internal, don't change)
HOLDEM_PROCESSOR_PORT=3030
BROADCAST_PORT=3032
REWARDS_API_PORT=5000
REWARDS_FRONTEND_PORT=4000
STREAKS_API_PORT=5001
STREAKS_FRONTEND_PORT=4001

# External Ports (change these if you have port conflicts)
# MYSQL_EXTERNAL_PORT=3307
# REDIS_EXTERNAL_PORT=6380
# DYNAMODB_EXTERNAL_PORT=8001

# Stage
STAGE=local

# ────────────────────────────────────────────────────────────────────
# New stack (apps/worker, apps/gateway, apps/coach, apps/web, apps/botswarm)
# ────────────────────────────────────────────────────────────────────

# Shared secret — gateway + web MUST match
GATEWAY_JWT_SECRET=dev-secret-change-me
JWT_SIGNING_SECRET=dev-secret-change-me
SESSION_SECRET=dev-session-change-me

# Backends (omit to use in-process fallbacks; required for cross-process pub/sub between worker and gateway)
# REDIS_URL=redis://localhost:6379
# DATABASE_URL=postgresql://postgres:dev@localhost:5432/hijack

# Service ports (defaults shown)
# PORT for worker = 3001 (default), gateway = 3002, web = 3000

# Web → gateway URLs
NEXT_PUBLIC_GATEWAY_WS_URL=ws://localhost:3002
NEXT_PUBLIC_GATEWAY_HTTP_URL=http://localhost:3002
GATEWAY_HTTP_URL=http://localhost:3002

# Botswarm
GATEWAY_WS_URL=ws://localhost:3002

# Optional — AI coach prose (skip to disable LLM)
# ANTHROPIC_API_KEY=

# Optional — OpenTelemetry (skip for no-op tracing)
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=
