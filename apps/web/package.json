{
  "name": "@hijack/web",
  "version": "0.1.0",
  "private": true,
  "description": "Hijack Poker — Next.js frontend (Vercel)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@hijack/protocol": "*",
    "bad-words": "^3.0.4",
    "jsonwebtoken": "^9.0.2",
    "next": "14.2.5",
    "qrcode": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.2"
  },
  "optionalDependencies": {
    "ioredis": "^5.4.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@dicebear/bottts-neutral": "^9.4.2",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-zone": "^1.25.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.1",
    "@opentelemetry/instrumentation": "^0.52.1",
    "@opentelemetry/instrumentation-fetch": "^0.52.1",
    "@opentelemetry/sdk-trace-web": "^1.25.1",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "next-pwa": "^5.6.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "ts-jest": "^29.2.3",
    "typescript": "^5.5.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.test.json"
        }
      ]
    }
  }
}
